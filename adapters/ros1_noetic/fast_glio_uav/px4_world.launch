<launch>
  <arg name="gui" default="false"/>
  <arg name="world"/>
  <arg name="sdf"/>
  <include file="$(env PX4_ROOT)/launch/posix_sitl.launch">
    <arg name="vehicle" value="iris"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="sdf" value="$(arg sdf)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="interactive" value="false"/>
    <arg name="x" value="0"/>
    <arg name="y" value="-20"/>
    <arg name="z" value="0"/>
  </include>
  <node pkg="uav_simulator" type="point_cloud_converter"
        name="point_cloud_converter" output="screen"/>
</launch>
