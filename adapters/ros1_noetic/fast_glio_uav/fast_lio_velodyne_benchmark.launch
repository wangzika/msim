<launch>
  <arg name="config_file" />
  <arg name="point_filter_num" default="2" />
  <param name="/use_sim_time" value="true" />
  <param name="/point_filter_num" type="int" value="$(arg point_filter_num)" />
  <rosparam file="$(arg config_file)" command="load" />
  <param name="/mapping/bias_freeze_en" value="false" />
  <!-- FAST-LIO reads the map size from the global parameter namespace. -->
  <param name="/cube_side_length" type="double" value="1000.0" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen">
    <param name="point_filter_num" type="int" value="$(arg point_filter_num)" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="lidar_update/enable" value="true" />
    <param name="gnss_loose/enable" value="false" />
    <param name="gnss_tight/enable" value="false" />
    <param name="gnss_raw_tight/enable" value="false" />
  </node>
</launch>
